static func par_palier(palier: int) -> Dictionary:
	var p := clampi(palier, 0, PROFILS.size() - 1)
	var profil: Dictionary = PROFILS[p].duplicate(true)
	profil["niveau"] = p + 1
	profil["tentatives_cibles"] = TENTATIVES_CIBLES[p]
	profil["victoires_farm"] = VICTOIRES_FARM[p]
	var equipements: Array = profil["equipements"]
	var forge: Dictionary = profil["forge"]
	profil["forge_familier"] = int(forge.get(str(equipements[4]), 0))
	return profil
